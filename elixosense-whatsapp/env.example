# Copy this file to `.env.local` for local development.
# Never commit real secrets.

## Database (required for any server-side DB access)
# Supabase provides this in Project Settings → Database → Connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

## Supabase (required)
# Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Optional compatibility alias (server-side fallback)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Server-only (planned / keep for future admin operations; do NOT expose to browser)
# Settings → API → service_role key (or "service key")
SUPABASE_SERVICE_KEY=YOUR_SUPABASE_SERVICE_KEY

## WhatsApp Cloud API (required for webhook + outbound)
WHATSAPP_API_TOKEN=YOUR_META_PERMANENT_ACCESS_TOKEN
# Meta naming: this is the "Phone Number ID" (phone_number_id) used in Graph API paths:
# POST https://graph.facebook.com/vXX.X/{phone-number-id}/messages
WHATSAPP_PHONE_NUMBER_ID=YOUR_PHONE_NUMBER_ID

# Backwards-compat alias (deprecated). Prefer WHATSAPP_PHONE_NUMBER_ID.
WHATSAPP_BUSINESS_NUMBER=YOUR_PHONE_NUMBER_ID
WHATSAPP_VERIFY_TOKEN=YOUR_WEBHOOK_VERIFY_TOKEN

# Strongly recommended in staging/prod to verify `X-Hub-Signature-256`
WHATSAPP_APP_SECRET=YOUR_WHATSAPP_APP_SECRET

## M-Pesa Daraja (required for STK push; manual verify can work without these)
MPESA_CALLBACK_URL=https://YOUR_DOMAIN/api/payments/mpesa-callback
SAFARICOM_API_KEY=YOUR_DARAJA_CONSUMER_KEY
SAFARICOM_API_SECRET=YOUR_DARAJA_CONSUMER_SECRET
SAFARICOM_SHORTCODE=YOUR_SHORTCODE
SAFARICOM_PASSKEY=YOUR_PASSKEY

# Optional: override to production base URL when going live
SAFARICOM_BASE_URL=https://sandbox.safaricom.co.ke

## Cron (required for `/api/cron/reminders`)
CRON_SECRET=replace-with-a-long-random-secret

