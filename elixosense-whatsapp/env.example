# Copy this file to `.env.local` for local development.
# Never commit real secrets.

## Database (required for any server-side DB access)
# Supabase provides this in Project Settings → Database → Connection string.
DATABASE_URL=done


## Supabase (required)
# Settings → API
NEXT_PUBLIC_SUPABASE_URL=done
NEXT_PUBLIC_SUPABASE_ANON_KEY=done

# Optional compatibility alias (server-side fallback)
SUPABASE_URL=done

# Server-only (planned / keep for future admin operations; do NOT expose to browser)
# Settings → API → service_role key (or "service key")
SUPABASE_SERVICE_KEY=done

## WhatsApp Cloud API (required for webhook + outbound)
WHATSAPP_API_TOKEN=done
# Meta naming: this is the "Phone Number ID" (phone_number_id) used in Graph API paths:
# POST https://graph.facebook.com/vXX.X/{phone-number-id}/messages
WHATSAPP_PHONE_NUMBER_ID=done

# Strongly recommended in staging/prod to verify `X-Hub-Signature-256`
WHATSAPP_APP_SECRET=done

## M-Pesa Daraja (required for STK push; manual verify can work without these)
MPESA_CALLBACK_URL=https://YOUR_DOMAIN/api/payments/mpesa-callback dont know what to put here
SAFARICOM_API_KEY=done
SAFARICOM_API_SECRET=done
SAFARICOM_SHORTCODE=N/A
SAFARICOM_PASSKEY=N/A

# Optional: override to production base URL when going live
SAFARICOM_BASE_URL=https://sandbox.safaricom.co.ke

## Cron (required for `/api/cron/reminders`)
CRON_SECRET= done
